# --- Ring (unofficial ring-client-api: live video + talk-back) ---
# Get this by running:  npm run auth   (logs in with your Ring email/password + 2FA)
# After the first run the app keeps the rotated token in data/ring-refresh-token.txt.
RING_REFRESH_TOKEN=

# --- Ring Partner API (official; events/webhooks/video only, no talk-back yet) ---
RING_PARTNER_CLIENT_ID=
RING_PARTNER_CLIENT_SECRET=
RING_PARTNER_HMAC_KEY=

# --- Claude (vision: decides whether someone needs help) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- ElevenLabs (voice) ---
ELEVENLABS_API_KEY=

# Set to true to log what the AI *would* say without unmuting the camera.
DRY_RUN=false
LOG_LEVEL=info
